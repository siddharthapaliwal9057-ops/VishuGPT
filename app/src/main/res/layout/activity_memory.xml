<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:padding="16dp">

    <!-- Top Bar -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Memory Vault"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/btnAddMemory" />

    <ImageView
        android:id="@+id/btnAddMemory"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:src="@drawable/ic_plus"
        android:contentDescription="Add Memory"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search Box -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="Search memories..."
        android:textColor="?attr/themeTextPrimary"
        android:textColorHint="?attr/themeTextMuted"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <!-- Category Chips Horizontal Scroll -->
    <HorizontalScrollView
        android:id="@+id/hsvCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/etSearch">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipCategoryAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_chip_selected"
                android:text="All"
                android:textSize="12sp"
                android:textColor="?attr/themeTextPrimary" />

            <TextView
                android:id="@+id/chipCategoryPersonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="Personal"
                android:textSize="12sp"
                android:textColor="?attr/themeTextSecondary" />

            <TextView
                android:id="@+id/chipCategoryPreferences"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="Preferences"
                android:textSize="12sp"
                android:textColor="?attr/themeTextSecondary" />

            <TextView
                android:id="@+id/chipCategoryContacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="Contacts"
                android:textSize="12sp"
                android:textColor="?attr/themeTextSecondary" />

            <TextView
                android:id="@+id/chipCategoryRoutines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="Routines"
                android:textSize="12sp"
                android:textColor="?attr/themeTextSecondary" />

            <TextView
                android:id="@+id/chipCategoryNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="Notes"
                android:textSize="12sp"
                android:textColor="?attr/themeTextSecondary" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvMemoryCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="0 Memories Stored"
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/hsvCategories"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMemories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvMemoryCount"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvNoMemories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No memories found."
        android:textColor="?attr/themeTextMuted"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvMemories"
        app:layout_constraintBottom_toBottomOf="@id/rvMemories"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
